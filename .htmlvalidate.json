{
  "extends": ["html-validate:recommended"],
  "rules": {
    "doctype-style": "error",
    "element-name": "error",
    "void-style": "error",
    "no-trailing-whitespace": "off",
    "script-type": "off",
    "no-inline-style": "off",
    "long-title": "off",
    "attribute-boolean-style": "off"
  }
}

