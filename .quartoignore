# Ignore all markdown files that aren't Quarto documents
*.md
!*.qmd

# Ignore documentation and build directories
/docs/
/docs/**
/docs/**/*
docs/
docs/**
docs/**/*
.quarto/

# Ignore source code directories
content/**/*.md
tools/**/*.md
articles/**/*.md
scripts/

# Ignore CI/CD and config
.github/
*.toml
*.ini

# Ignore backup files
*_backup/
*.bak
*.backup
