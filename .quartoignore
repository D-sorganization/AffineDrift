# Ignore all markdown files that aren't Quarto documents
*.md
!*.qmd

# Ignore documentation and build directories (must be first)
docs/
docs/**
docs/**/*.md
docs/CODE_QUALITY_RULES.md
_site/
.quarto/

# Ignore root-level documentation files explicitly
QUARTO_LOCAL_TESTING.md
BRANCH_REVIEW_SUMMARY.md
CONTRIBUTING.md
WEBSITE_ANALYSIS_COMPLETED.md
MERGE_STATUS.md
CONTENT_SHARING_GUIDE.md
MAIN_VS_CURRENT_COMPARISON.md
QUARTO_GUIDE.md
UNIFIED_CI_APPROACH.md
PREVIEW_INSTRUCTIONS.md
DEVELOPMENT_GUIDE.md
DNS_SETUP.md
REPO_STATE_REVIEW.md
REPOSITORY_PROTECTION.md
WEBSITE_ANALYSIS.md
WEBSITE_MANAGEMENT.md
MERGE_PLAN.md
README.md

# Ignore source code directories
content/**/*.md
tools/**/*.md
articles/**/*.md
scripts/

# Ignore CI/CD and config
.github/
*.toml
*.ini

# Ignore backup files
*_backup/
*.bak
*.backup

