\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{golf_physics}[2026/03/26 Style primitives for The Physics of Golf textbook]

% ──────────────────────────────────────────────
% Inherit shared series primitives
% ──────────────────────────────────────────────
\RequirePackage{xcolor}
\RequirePackage{listings}

\makeatletter
\newcommand{\gpdefinecolorifmissing}[3]{%
  \@ifundefined{color@#1}{\definecolor{#1}{#2}{#3}}{}%
}
\makeatother

% ──────────────────────────────────────────────
% Color Palette — golf-themed extension of GoM
% ──────────────────────────────────────────────
\gpdefinecolorifmissing{chapblue}{RGB}{0, 70, 130}      % Chapter headings
\gpdefinecolorifmissing{accentred}{RGB}{180, 40, 40}     % Theorems
\gpdefinecolorifmissing{softgray}{RGB}{245, 245, 245}    % Examples / exercises
\gpdefinecolorifmissing{trajgreen}{RGB}{30, 130, 60}     % Trajectories / golf green
\gpdefinecolorifmissing{darkgold}{RGB}{160, 120, 20}     % Definitions
\gpdefinecolorifmissing{purplehaze}{RGB}{100, 40, 140}   % Algorithms
\gpdefinecolorifmissing{driftblue}{RGB}{50, 100, 180}    % Drift components
\gpdefinecolorifmissing{controlred}{RGB}{200, 60, 60}    % Control components
\gpdefinecolorifmissing{constraintgold}{RGB}{180, 140, 30} % Constraint forces
\gpdefinecolorifmissing{fasciarust}{RGB}{160, 90, 50}    % Fascia / tissue
\gpdefinecolorifmissing{shaftsilver}{RGB}{140, 140, 160} % Shaft mechanics

% ──────────────────────────────────────────────
% Code listings style
% ──────────────────────────────────────────────
\gpdefinecolorifmissing{gpcodegreen}{rgb}{0,0.6,0}
\gpdefinecolorifmissing{gpcodegray}{rgb}{0.5,0.5,0.5}
\gpdefinecolorifmissing{gpcodepurple}{rgb}{0.58,0,0.82}
\gpdefinecolorifmissing{gpbackcolour}{rgb}{0.95,0.95,0.92}
\lstdefinestyle{gppython}{
  backgroundcolor=\color{gpbackcolour},
  commentstyle=\color{gpcodegreen},
  keywordstyle=\color{magenta},
  numberstyle=\tiny\color{gpcodegray},
  stringstyle=\color{gpcodepurple},
  basicstyle=\ttfamily\footnotesize,
  breakatwhitespace=false,
  breaklines=true,
  captionpos=b,
  keepspaces=true,
  numbers=left,
  numbersep=5pt,
  showspaces=false,
  showstringspaces=false,
  showtabs=false,
  tabsize=2
}
\newcommand{\gpapplylistingstyle}{\lstset{style=gppython}}

% ──────────────────────────────────────────────
% Golf-specific math commands
% ──────────────────────────────────────────────
% State and control
\newcommand{\state}{\bm{x}}
\newcommand{\control}{\bm{u}}
\newcommand{\configvec}{\bm{q}}
\newcommand{\configdot}{\dot{\bm{q}}}
\newcommand{\configddot}{\ddot{\bm{q}}}
\newcommand{\traj}{\bm{\gamma}}
\newcommand{\Reals}{\mathbb{R}}
\newcommand{\dd}{\mathrm{d}}
\newcommand{\dt}{\,\dd t}

% Affine system components
\newcommand{\drift}{f(\state)}
\newcommand{\inputmap}{G(\state)}
\newcommand{\driftfield}{f}
\newcommand{\inputfield}{G}

% Dynamics matrices
\newcommand{\massmat}{\bm{M}(\configvec)}
\newcommand{\cormat}{\bm{C}(\configvec, \configdot)}
\newcommand{\gravvec}{\bm{g}(\configvec)}
\newcommand{\jacobian}{\bm{J}(\configvec)}

% Golf-specific
\newcommand{\clubhead}{\bm{p}_{\mathrm{head}}}
\newcommand{\clubvel}{\bm{v}_{\mathrm{head}}}
\newcommand{\swingplane}{\mathcal{P}_{\mathrm{swing}}}
\newcommand{\shaftflex}{\bm{\eta}}
\newcommand{\shaftflexdot}{\dot{\bm{\eta}}}
\newcommand{\shaftstiff}{K_s}
\newcommand{\shaftdamp}{D_s}

% Counterfactual labels
\newcommand{\ztcf}{\mathrm{ZTCF}}
\newcommand{\zvcf}{\mathrm{ZVCF}}
\newcommand{\dcr}{\mathrm{DCR}}

% Constraint and wrench
\newcommand{\wrench}{\mathcal{F}}
\newcommand{\twist}{\mathcal{V}}
\newcommand{\screw}{\mathcal{S}}
\newcommand{\constraintforce}{\bm{\lambda}}
\newcommand{\loopjac}{\bm{J}_{\mathrm{loop}}}

% Norms and operators
\newcommand{\norm}[1]{\left\lVert #1 \right\rVert}
\newcommand{\inner}[2]{\left\langle #1,\, #2 \right\rangle}
\DeclareMathOperator*{\argmin}{arg\,min}
\DeclareMathOperator*{\argmax}{arg\,max}

% Lie groups (golf-relevant subset)
\newcommand{\se}{\mathfrak{se}(3)}
\newcommand{\so}{\mathfrak{so}(3)}
\newcommand{\SE}{\mathrm{SE}(3)}
\newcommand{\SO}{\mathrm{SO}(3)}
