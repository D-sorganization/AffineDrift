# AffineDrift Environment Variables Template
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# ============================================================================
# GitHub Configuration
# ============================================================================
# GitHub Personal Access Token (for automated workflows)
# Required scopes: repo, workflow
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Jules API Key (for AI-powered automation agents)
# Contact repository maintainer for access
JULES_API_KEY=your_jules_api_key_here

# ============================================================================
# Python Environment
# ============================================================================
# Python version (should match CI/CD workflows)
PYTHON_VERSION=3.12

# Virtual environment name (optional)
VENV_NAME=affinedrift-env

# ============================================================================
# Build Configuration
# ============================================================================
# Quarto version (pinned for reproducibility)
QUARTO_VERSION=1.6.39

# Build output directory
BUILD_DIR=docs

# ============================================================================
# Development Settings
# ============================================================================
# Enable debug mode for verbose logging
DEBUG=false

# Development server port (for quarto preview)
DEV_PORT=4000

# ============================================================================
# CI/CD Settings
# ============================================================================
# Enable dry-run mode for testing workflows
DRY_RUN=false

# Maximum number of issues to process in automated workflows
MAX_ISSUES_PER_RUN=10

# ============================================================================
# Optional: External Services
# ============================================================================
# Analytics or monitoring service keys (if applicable)
# ANALYTICS_KEY=your_analytics_key_here

# External API endpoints (if applicable)
# API_ENDPOINT=https://api.example.com
