# Auto-detect text files and normalize line endings to LF
* text=auto

# Force LF for all text source files (prevents CRLF noise on Windows)
*.tex text eol=lf
*.bib text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.qmd text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.txt text eol=lf
*.r text eol=lf
*.R text eol=lf

# Binary files (never normalize)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
/*.pdf filter=lfs diff=lfs merge=lfs -text
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
