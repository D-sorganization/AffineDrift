{
  "include_roots": ["src", "scripts", "js", "tests", ".github", "README.md"],
  "exclude_substrings": [
    ".git/",
    "node_modules/",
    "docs/assessments/archive/",
    "archive/",
    "legacy-pages/"
  ],
  "file_extensions": [
    ".py",
    ".js",
    ".ts",
    ".tsx",
    ".css",
    ".scss",
    ".md",
    ".qmd",
    ".yml",
    ".yaml"
  ],
  "max_total_markers": 47,
  "max_per_marker": {
    "TODO": 20,
    "FIXME": 13,
    "TRACKED_TASK": 15,
    "TRACKED_DEFECT": 10,
    "HACK": 8,
    "XXX": 10
  }
}
