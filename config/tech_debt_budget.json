{
  "include_roots": [
    "src",
    "scripts",
    "js",
    "tests",
    ".github",
    "README.md"
  ],
  "exclude_substrings": [
    ".git/",
    "node_modules/",
    "docs/assessments/archive/",
    "archive/",
    "legacy-pages/"
  ],
  "file_extensions": [
    ".py",
    ".js",
    ".ts",
    ".tsx",
    ".css",
    ".scss",
    ".md",
    ".qmd",
    ".yml",
    ".yaml"
  ],
  "max_total_markers": 46,
  "max_per_marker": {
    "TODO": 20,
    "FIXME": 12,
    "HACK": 8,
    "XXX": 10
  }
}
