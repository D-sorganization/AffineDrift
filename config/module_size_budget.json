{
  "include_roots": ["src", "scripts", "js", "styles.css"],
  "exclude_substrings": ["node_modules/", "docs/", "archive/", "__pycache__/"],
  "max_lines_by_extension": {
    ".py": 750,
    ".js": 700,
    ".css": 4200
  },
  "explicit_limits": {
    "src/js/bibliography.js": 500,
    "src/core/contracts.py": 450,
    "styles.css": 3400
  }
}
