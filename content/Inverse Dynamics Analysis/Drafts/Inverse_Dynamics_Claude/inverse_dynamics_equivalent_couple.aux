\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Late downswing scenario showing how the same inverse dynamics result ($M_m > 0$, $C_m < 0$) can lead to opposite-sign couples depending on force application location. This ambiguity is central to the alpha torque debate.}}{6}{figure.caption.4}\protected@file@percent }
\newlabel{fig:alpha_debate}{{4}{6}{Late downswing scenario showing how the same inverse dynamics result ($M_m > 0$, $C_m < 0$) can lead to opposite-sign couples depending on force application location. This ambiguity is central to the alpha torque debate}{figure.caption.4}{}}
