\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Distributed forces from multiple contact points (left) reduce to an equivalent single force and couple at the midpoint (right). The couple arises from the spatial distribution of forces, not necessarily from a twisting action.}}{3}{figure.caption.2}\protected@file@percent }
