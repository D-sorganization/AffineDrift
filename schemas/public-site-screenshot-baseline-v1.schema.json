{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://affinedrift.com/schemas/public-site-screenshot-baseline-v1.schema.json",
  "title": "AffineDrift Public Site Screenshot Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "approval",
    "source_revision",
    "browser",
    "capture_count",
    "captures"
  ],
  "properties": {
    "schema_version": {
      "const": "affinedrift/public-site-screenshot-baseline/v1"
    },
    "status": { "enum": ["candidate", "approved"] },
    "approval": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reviewed_by", "reviewed_at", "pull_request"],
          "properties": {
            "reviewed_by": { "type": "string", "minLength": 1 },
            "reviewed_at": { "type": "string", "format": "date-time" },
            "pull_request": {
              "type": "string",
              "pattern": "^https://github.com/"
            }
          }
        }
      ]
    },
    "source_revision": { "type": "string", "minLength": 1 },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "capture_count": { "type": "integer", "minimum": 1 },
    "captures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "route",
          "route_family",
          "scenario_id",
          "viewport",
          "theme",
          "width",
          "height",
          "sha256"
        ],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "route": { "type": "string", "pattern": "^/" },
          "route_family": { "type": "string", "minLength": 1 },
          "scenario_id": { "type": "string", "minLength": 1 },
          "viewport": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "width", "height"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            }
          },
          "theme": { "enum": ["light", "dark"] },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "approved" } } },
      "then": { "properties": { "approval": { "type": "object" } } }
    }
  ]
}
