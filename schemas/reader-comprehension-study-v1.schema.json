{
  "": "https://affinedrift.com/schemas/reader-comprehension-study-v1.schema.json",
  "title": "AffineDrift Reader Comprehension and Findability Study Schema",
  "description": "Governed schema for preregistered reader findability, evidence comprehension, and negative findings reporting (Issue #4088).",
  "type": "object",
  "required": [
    "schema_version",
    "study_id",
    "title",
    "preregistration",
    "tasks",
    "cohorts",
    "observations",
    "summary_metrics",
    "null_negative_findings",
    "remediation_issues",
    "authority_boundary",
    "generated_on"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "affinedrift.reader-comprehension-study/v1"
    },
    "study_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "preregistration": {
      "type": "object",
      "required": [
        "hypotheses",
        "primary_outcome",
        "secondary_outcomes",
        "target_sample_size",
        "exclusion_criteria",
        "preregistered_date"
      ],
      "additionalProperties": false,
      "properties": {
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "primary_outcome": {
          "type": "string"
        },
        "secondary_outcomes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "target_sample_size": {
          "type": "integer",
          "minimum": 1
        },
        "exclusion_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "preregistered_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "task_number",
          "title",
          "description",
          "expected_target",
          "success_criterion"
        ],
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string"
          },
          "task_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "expected_target": {
            "type": "string"
          },
          "success_criterion": {
            "type": "string"
          }
        }
      }
    },
    "cohorts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "enum": ["technical_reviewer", "general_reader"]
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "participant_id",
          "cohort",
          "task_id",
          "completed",
          "duration_ms",
          "navigation_errors",
          "comprehension_score",
          "confidence_score",
          "accessibility_barriers",
          "reported_limitations"
        ],
        "additionalProperties": false,
        "properties": {
          "participant_id": {
            "type": "string"
          },
          "cohort": {
            "type": "string",
            "enum": ["technical_reviewer", "general_reader"]
          },
          "task_id": {
            "type": "string"
          },
          "completed": {
            "type": "boolean"
          },
          "duration_ms": {
            "type": "number",
            "minimum": 0
          },
          "navigation_errors": {
            "type": "integer",
            "minimum": 0
          },
          "comprehension_score": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "confidence_score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "accessibility_barriers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reported_limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "summary_metrics": {
      "type": "object",
      "required": [
        "total_participants",
        "cohort_metrics",
        "task_metrics",
        "overall_completion_rate",
        "overall_comprehension_rate"
      ],
      "additionalProperties": false,
      "properties": {
        "total_participants": {
          "type": "integer",
          "minimum": 1
        },
        "cohort_metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "participant_count",
              "completion_rate",
              "completion_ci_95",
              "mean_comprehension_score",
              "median_duration_ms",
              "error_rate_per_task"
            ],
            "additionalProperties": false,
            "properties": {
              "participant_count": {
                "type": "integer"
              },
              "completion_rate": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              },
              "completion_ci_95": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 1.0
                }
              },
              "mean_comprehension_score": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              },
              "median_duration_ms": {
                "type": "number",
                "minimum": 0
              },
              "error_rate_per_task": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "task_metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "task_number",
              "completion_rate",
              "mean_comprehension_score",
              "median_duration_ms",
              "total_errors"
            ],
            "additionalProperties": false,
            "properties": {
              "task_number": {
                "type": "integer"
              },
              "completion_rate": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              },
              "mean_comprehension_score": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              },
              "median_duration_ms": {
                "type": "number",
                "minimum": 0
              },
              "total_errors": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "overall_completion_rate": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "overall_comprehension_rate": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "null_negative_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "description",
          "observed_effect",
          "implication"
        ],
        "additionalProperties": false,
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "observed_effect": {
            "type": "string"
          },
          "implication": {
            "type": "string"
          }
        }
      }
    },
    "remediation_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issue_id",
          "title",
          "task_id",
          "status",
          "target_issue_url"
        ],
        "additionalProperties": false,
        "properties": {
          "issue_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["open", "resolved", "tracked"]
          },
          "target_issue_url": {
            "type": "string"
          }
        }
      }
    },
    "authority_boundary": {
      "type": "string",
      "minLength": 20
    },
    "generated_on": {
      "type": "string",
      "format": "date"
    }
  }
}
