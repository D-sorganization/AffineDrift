{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://affinedrift.com/schemas/markerless_mocap_publication_projection_v1.schema.json",
  "title": "Markerless Mocap Publication Projection Version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "license",
    "privacy",
    "security",
    "qualification",
    "claims",
    "artifacts"
  ],
  "properties": {
    "schema": { "const": "affinedrift/mocap-publication-projection/v1" },
    "source": { "$ref": "#/$defs/source" },
    "license": { "$ref": "#/$defs/license" },
    "privacy": { "$ref": "#/$defs/privacy" },
    "security": { "$ref": "#/$defs/security" },
    "qualification": { "$ref": "#/$defs/qualification" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/claim" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "release_manifest_sha256",
        "source_url"
      ],
      "properties": {
        "repository": {
          "enum": ["D-sorganization/Tools", "D-sorganization/UpstreamDrift"]
        },
        "revision": { "$ref": "#/$defs/revision" },
        "release_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publication_spdx", "components"],
      "properties": {
        "publication_spdx": { "const": "MIT" },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "spdx", "distribution"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "spdx": {
                "enum": [
                  "Apache-2.0",
                  "BSD-2-Clause",
                  "BSD-3-Clause",
                  "CC-BY-4.0",
                  "CC0-1.0",
                  "ISC",
                  "MIT"
                ]
              },
              "distribution": { "enum": ["embedded", "linked"] }
            }
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review",
        "consent",
        "retention",
        "contains_raw_video",
        "contains_pii",
        "contains_secrets"
      ],
      "properties": {
        "review": { "const": "approved" },
        "consent": { "enum": ["not_applicable", "public_release_approved"] },
        "retention": { "const": "sanitized_artifacts_only" },
        "contains_raw_video": { "const": false },
        "contains_pii": { "const": false },
        "contains_secrets": { "const": false }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review", "malware_scan"],
      "properties": {
        "review": { "const": "approved" },
        "malware_scan": { "const": "passed" }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "status",
        "authority_repository",
        "protocol_version"
      ],
      "properties": {
        "origin": { "enum": ["live_lab", "protected_release", "synthetic"] },
        "status": { "const": "qualified" },
        "authority_repository": {
          "enum": ["D-sorganization/Tools", "D-sorganization/UpstreamDrift"]
        },
        "protocol_version": { "type": "string", "minLength": 1 }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "evidence_class", "status", "artifact_ids"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "evidence_class": {
          "enum": ["derived", "model_scenario", "observed", "unavailable"]
        },
        "status": { "enum": ["qualified", "unavailable"] },
        "artifact_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "kind",
        "classification",
        "media_type",
        "sha256",
        "bytes",
        "source_license",
        "source_url"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "aggregate_statistics",
            "calibration_summary",
            "compatibility_report",
            "derived_kinematics",
            "sanitized_c3d",
            "schema",
            "validation_report",
            "visualization"
          ]
        },
        "classification": {
          "enum": [
            "public_aggregate",
            "qualified_model_scenario",
            "sanitized_derived"
          ]
        },
        "media_type": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 },
        "source_license": {
          "enum": [
            "Apache-2.0",
            "BSD-2-Clause",
            "BSD-3-Clause",
            "CC-BY-4.0",
            "CC0-1.0",
            "ISC",
            "MIT"
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    }
  }
}
