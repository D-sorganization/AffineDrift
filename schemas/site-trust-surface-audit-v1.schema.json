{
  "$id": "https://affinedrift.com/schemas/site-trust-surface-audit-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "issue_url": {
      "const": "https://github.com/D-sorganization/AffineDrift/issues/4063"
    },
    "method": {
      "additionalProperties": false,
      "properties": {
        "first_pass": { "$ref": "#/$defs/nonempty" },
        "second_pass": { "$ref": "#/$defs/nonempty" }
      },
      "required": ["first_pass", "second_pass"],
      "type": "object"
    },
    "routes": {
      "items": { "$ref": "#/$defs/routeReview" },
      "maxItems": 13,
      "minItems": 13,
      "type": "array"
    },
    "schema_version": { "const": "1.0.0" }
  },
  "required": ["schema_version", "issue_url", "method", "routes"],
  "title": "AffineDrift Site-Level Trust-Surface Audit",
  "type": "object",
  "$defs": {
    "adversarialReview": {
      "additionalProperties": false,
      "properties": {
        "alternative_mechanisms": { "$ref": "#/$defs/nonemptyList" },
        "counterexamples": { "$ref": "#/$defs/nonemptyList" },
        "remaining_disagreements": { "$ref": "#/$defs/nonemptyList" }
      },
      "required": [
        "counterexamples",
        "alternative_mechanisms",
        "remaining_disagreements"
      ],
      "type": "object"
    },
    "authority": {
      "additionalProperties": false,
      "properties": {
        "authority_type": {
          "enum": [
            "canonical_source",
            "external_primary_source",
            "normative_contract",
            "personal_statement",
            "protected_software_source",
            "public_channel"
          ]
        },
        "limits": { "$ref": "#/$defs/nonemptyList" },
        "references": {
          "items": {
            "pattern": "^(https://|[A-Za-z0-9_.-]+/|index\\.qmd|NOTATION\\.md)[A-Za-z0-9_./?#&=-]*$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": ["authority_type", "references", "limits"],
      "type": "object"
    },
    "claim": {
      "additionalProperties": false,
      "properties": {
        "assumptions": { "$ref": "#/$defs/nonemptyList" },
        "audience_limits": { "$ref": "#/$defs/nonemptyList" },
        "authority": { "$ref": "#/$defs/authority" },
        "boundaries": { "$ref": "#/$defs/nonemptyList" },
        "claim_classes": {
          "items": { "$ref": "#/$defs/claimClass" },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "claim_id": {
          "pattern": "^ad-surface-[a-z0-9-]+-[0-9]{3}$",
          "type": "string"
        },
        "finding_id": {
          "pattern": "^ad-finding-[a-z0-9-]+$",
          "type": "string"
        },
        "falsifiers": { "$ref": "#/$defs/nonemptyList" },
        "publication_state": { "$ref": "#/$defs/publicationState" },
        "statement": { "$ref": "#/$defs/nonempty" },
        "uncertainty": { "$ref": "#/$defs/nonemptyList" }
      },
      "required": [
        "claim_id",
        "claim_classes",
        "statement",
        "publication_state",
        "authority",
        "assumptions",
        "boundaries",
        "uncertainty",
        "falsifiers",
        "audience_limits",
        "finding_id"
      ],
      "type": "object"
    },
    "claimClass": {
      "enum": [
        "causal",
        "clinical_coaching",
        "comparative",
        "factual",
        "mathematical",
        "quantitative",
        "research_readiness",
        "software_capability"
      ],
      "type": "string"
    },
    "finding": {
      "additionalProperties": false,
      "properties": {
        "claim_ids": {
          "items": { "pattern": "^ad-[a-z0-9-]+-[0-9]{3}$", "type": "string" },
          "type": "array",
          "uniqueItems": true
        },
        "critique_ids": {
          "items": { "pattern": "^crit-[a-z0-9-]+$", "type": "string" },
          "type": "array",
          "uniqueItems": true
        },
        "disposition": {
          "enum": [
            "corrected",
            "publication_blocked",
            "open",
            "deferred",
            "exempt"
          ]
        },
        "evidence_paths": {
          "items": {
            "pattern": "^(index\\.qmd|NOTATION\\.md|styles\\.css|articles|critiques|data|pages|reports|scripts|src|tests)/?[A-Za-z0-9_./-]*$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "finding_id": {
          "pattern": "^ad-finding-[a-z0-9-]+$",
          "type": "string"
        },
        "issue_url": {
          "const": "https://github.com/D-sorganization/AffineDrift/issues/4063"
        },
        "priority": { "enum": ["p0", "p1", "p2", "p3"] },
        "rationale": { "$ref": "#/$defs/nonempty" },
        "verification_commit": { "pattern": "^[0-9a-f]{40}$", "type": "string" }
      },
      "required": [
        "finding_id",
        "priority",
        "disposition",
        "issue_url",
        "rationale",
        "claim_ids",
        "critique_ids",
        "evidence_paths",
        "verification_commit"
      ],
      "type": "object"
    },
    "nonempty": { "minLength": 1, "type": "string" },
    "nonemptyList": {
      "items": { "$ref": "#/$defs/nonempty" },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "publicationState": {
      "enum": [
        "available",
        "validated",
        "experimental",
        "planned",
        "deprecated",
        "opinion"
      ],
      "type": "string"
    },
    "routeReview": {
      "additionalProperties": false,
      "properties": {
        "adversarial_review": { "$ref": "#/$defs/adversarialReview" },
        "audit_id": { "pattern": "^ad-route-[0-9a-f]{12}$", "type": "string" },
        "claim_classes": {
          "items": { "$ref": "#/$defs/claimClass" },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "claims": {
          "items": { "$ref": "#/$defs/claim" },
          "minItems": 1,
          "type": "array"
        },
        "findings": {
          "items": { "$ref": "#/$defs/finding" },
          "minItems": 1,
          "type": "array"
        },
        "included_source_paths": {
          "items": {
            "pattern": "^(NOTATION\\.md|pages/[A-Za-z0-9_.-]+\\.qmd)$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "included_source_sha256": {
          "additionalProperties": { "$ref": "#/$defs/sha256" },
          "propertyNames": {
            "pattern": "^(NOTATION\\.md|pages/[A-Za-z0-9_.-]+\\.qmd)$"
          },
          "type": "object"
        },
        "render_revision": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
        "reviewed_on": { "format": "date", "type": "string" },
        "reviewer": { "$ref": "#/$defs/nonempty" },
        "route": { "pattern": "^/([^?#]*)$", "type": "string" },
        "source_path": {
          "pattern": "^(index\\.qmd|pages/[A-Za-z0-9_.-]+\\.qmd)$",
          "type": "string"
        },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "source_revision": { "pattern": "^[0-9a-f]{40}$", "type": "string" }
      },
      "required": [
        "audit_id",
        "route",
        "source_path",
        "source_sha256",
        "included_source_sha256",
        "source_revision",
        "render_revision",
        "reviewed_on",
        "reviewer",
        "claim_classes",
        "claims",
        "findings",
        "adversarial_review"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  }
}
