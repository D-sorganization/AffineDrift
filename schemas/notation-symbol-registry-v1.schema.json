{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://affinedrift.com/schemas/notation-symbol-registry-v1.schema.json",
  "title": "AffineDrift Reserved Notation Symbol Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scope_note", "symbols"],
  "properties": {
    "schema": { "const": "affinedrift/notation-symbol-registry/v1" },
    "scope_note": { "type": "string", "minLength": 1 },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "symbol",
          "tex",
          "meaning",
          "shape",
          "source_anchor",
          "notation_witness"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "symbol": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
          "tex": { "type": "string", "minLength": 1 },
          "meaning": { "type": "string", "minLength": 1 },
          "shape": { "type": "string", "minLength": 1 },
          "unit": { "type": "string", "minLength": 1 },
          "frame": { "type": "string", "minLength": 1 },
          "sign": { "type": "string", "minLength": 1 },
          "source_anchor": {
            "type": "string",
            "pattern": "^/pages/notation\\.html#[a-z0-9-]+$"
          },
          "notation_heading": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "notation_witness": { "type": "string", "minLength": 1 },
          "forbidden_roles": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
          }
        }
      }
    }
  }
}
