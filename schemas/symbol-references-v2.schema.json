{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://affinedrift.com/schemas/symbol-references-v2.schema.json",
  "title": "AffineDrift symbol references registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "anchor", "symbols"],
  "properties": {
    "schema": {
      "const": "affinedrift/symbol-references/v2"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "anchor": {
      "type": "string",
      "minLength": 1
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "tex", "name", "definition"],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]*$"
          },
          "tex": { "type": "string" },
          "name": { "type": "string" },
          "definition": { "type": "string" },
          "unit": { "type": "string" },
          "shape": { "type": "string" },
          "frame": { "type": "string" },
          "sign": { "type": "string" },
          "source_anchor": { "type": "string" }
        }
      }
    }
  }
}
