{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://affinedrift.com/schemas/canonical-parameters-v1.schema.json",
  "title": "AffineDrift canonical parameters registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope_intro", "entries"],
  "properties": {
    "literal_aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parameter_id", "value", "tolerance", "permitted_paths", "reason"],
        "properties": {
          "parameter_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "value": { "type": "number" },
          "tolerance": { "type": "number", "minimum": 0 },
          "permitted_paths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "stale_markers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern", "reason"],
        "properties": {
          "pattern": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "scope_intro": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "name",
          "symbol",
          "unit",
          "definition",
          "value",
          "value_kind",
          "source",
          "rule_or_standard",
          "chapters",
          "upstream",
          "affine_refs",
          "literal_checks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "category": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "symbol": { "type": "string", "minLength": 1 },
          "unit": { "type": "string" },
          "definition": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 },
          "value_kind": {
            "type": "string",
            "enum": ["scalar", "vector", "tensor", "set", "text", "formula", "range"]
          },
          "source": { "type": "string", "minLength": 1 },
          "rule_or_standard": { "type": "string" },
          "chapters": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "upstream": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "symbol"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "symbol": { "type": "string", "minLength": 1 }
              }
            }
          },
          "affine_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "literal_checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path_glob", "pattern", "expected", "tolerance"],
              "properties": {
                "path_glob": { "type": "string", "minLength": 1 },
                "pattern": { "type": "string", "minLength": 1 },
                "expected": { "type": "number" },
                "tolerance": { "type": "number", "minimum": 0 },
                "note": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}