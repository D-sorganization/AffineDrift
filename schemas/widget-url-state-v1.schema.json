{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://affinedrift.com/schemas/widget-url-state-v1.schema.json",
  "title": "AffineDrift Widget URL-Hash State Envelope (v1)",
  "description": "Versioned, bounded, isolated per-widget URL-hash state payload encoded after #state= (#5255).",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "w", "p"],
  "properties": {
    "v": {
      "const": 1,
      "description": "Schema version (must be integer 1)."
    },
    "w": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,40}$",
      "description": "Target widget identifier (isolates state to a single widget; no cross-widget bus)."
    },
    "p": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x0", "ubar", "horizon", "phase"],
      "properties": {
        "x0": {
          "type": "number",
          "minimum": -100,
          "maximum": 100,
          "not": { "const": 0 }
        },
        "ubar": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "horizon": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "phase": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
