{
  "": "https://affinedrift.com/schemas/research-artifact-release-v1.schema.json",
  "title": "AffineDrift Governed Research Artifact Release Schema",
  "description": "Schema for reproducible research releases, checksummed artifacts, execution reports, and independent reviews (Issue #4042).",
  "type": "object",
  "required": [
    "schema_version",
    "release_id",
    "release_level",
    "title",
    "protocol_id",
    "provenance",
    "artifacts",
    "analysis_execution",
    "uncertainty_and_limitations",
    "independent_review",
    "authority_boundary",
    "released_on"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "affinedrift.research-artifact-release/v1"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "release_level": {
      "type": "string",
      "enum": [
        "exploratory",
        "internally_reviewed",
        "independently_reviewed",
        "replicated",
        "qualified"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "protocol_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "provenance": {
      "type": "object",
      "required": [
        "git_commit",
        "repository_url",
        "environment_pins",
        "license"
      ],
      "additionalProperties": false,
      "properties": {
        "git_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "repository_url": {
          "type": "string",
          "format": "uri"
        },
        "environment_pins": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "license": {
          "type": "string"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "byte_size", "kind", "description"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "byte_size": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "analysis_execution": {
      "type": "object",
      "required": [
        "command",
        "exit_code",
        "runtime_seconds",
        "outputs_produced"
      ],
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "runtime_seconds": {
          "type": "number",
          "minimum": 0
        },
        "outputs_produced": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "uncertainty_and_limitations": {
      "type": "object",
      "required": [
        "measured_quantities",
        "modeled_quantities",
        "assumed_quantities",
        "unavailable_quantities",
        "known_limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "measured_quantities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modeled_quantities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assumed_quantities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unavailable_quantities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "known_limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "independent_review": {
      "type": "object",
      "required": [
        "reviewer_id",
        "review_scope",
        "conflict_of_interest_statement",
        "disposition",
        "findings",
        "verification_commit"
      ],
      "additionalProperties": false,
      "properties": {
        "reviewer_id": {
          "type": "string"
        },
        "review_scope": {
          "type": "string"
        },
        "conflict_of_interest_statement": {
          "type": "string"
        },
        "disposition": {
          "type": "string",
          "enum": ["approved", "conditional", "rejected", "pending"]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "supersession_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["superseded_by", "reason", "effective_date"],
        "additionalProperties": false,
        "properties": {
          "superseded_by": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "effective_date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "authority_boundary": {
      "type": "string",
      "minLength": 20
    },
    "released_on": {
      "type": "string",
      "format": "date"
    }
  }
}
