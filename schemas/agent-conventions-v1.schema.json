{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://affinedrift.com/schemas/agent-conventions-v1.schema.json",
  "title": "AffineDrift agent conventions registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scope_note", "sources", "conventions"],
  "properties": {
    "schema": {
      "const": "affinedrift/agent-conventions/v1"
    },
    "scope_note": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "source", "rendered"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "rendered": {
            "type": "string",
            "pattern": "^/pages/.+\\.html"
          }
        }
      }
    },
    "conventions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "name", "summary", "source_anchor"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "category": {
            "type": "string",
            "enum": ["rotation", "frame", "units", "sign", "control_affine", "spatial_vectors"]
          },
          "name": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "frame": { "type": "string" },
          "sign": { "type": "string" },
          "unit": { "type": "string" },
          "source_anchor": {
            "type": "string",
            "pattern": "^/pages/.+\\.html(#.+)?$"
          }
        }
      }
    }
  }
}