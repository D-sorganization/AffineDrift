{
  "name": "affinedrift",
  "version": "1.0.0",
  "description": "AffineDrift website - Golf biomechanics and control theory",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "lint:css": "stylelint \"**/*.{css,scss}\"",
    "lint:html": "html-validate \"**/*.html\" --config .htmlvalidate.json"
  },
  "keywords": [
    "golf",
    "biomechanics",
    "control-theory"
  ],
  "author": "Dieter Olson",
  "license": "MIT",
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.40.0",
    "html-validate": "^8.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-config-standard-scss": "^13.0.0"
  }
}
