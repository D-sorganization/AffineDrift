# Quarto-generated data copies in docs/ (issue #1470)
# Source of truth is data/ directory; docs/data/ is generated by build.
docs/data/

# Quarto build output in docs/ - deployed via CI/CD artifact (issue #1419)
# The deploy-website workflow renders QMDs and deploys to GitHub Pages.
# Manually maintained dirs remain tracked:
#   docs/assessments/, docs/development/, docs/adr/, docs/architecture/,
#   docs/content/, docs/reference/, docs/static/, docs/templates/, docs/articles/
# Always-tracked infra files: docs/CNAME, docs/.nojekyll
docs/**/*.html
docs/search.json
docs/feed.xml
docs/sitemap.xml
